# --- Model provider -------------------------------------------------------
# "mock" runs a deterministic offline policy (no key, no cost) - used by CI.
# "anthropic" calls Claude. Credentials resolve from ANTHROPIC_API_KEY or an
# `ant auth login` profile.
TICKETPILOT_PROVIDER=mock
ANTHROPIC_API_KEY=

# Routing: easy tickets -> small model, hard tickets -> reasoning model
TICKETPILOT_SMALL_MODEL=claude-haiku-4-5
TICKETPILOT_REASONING_MODEL=claude-opus-5-5
TICKETPILOT_REASONING_EFFORT=high

# Fallback when the primary provider is down: "none" | "bedrock"
TICKETPILOT_FALLBACK_PROVIDER=none
AWS_REGION=us-east-1

# --- Per-run budgets ------------------------------------------------------
TICKETPILOT_MAX_COST_USD=0.50
TICKETPILOT_MAX_SECONDS=120
TICKETPILOT_MAX_STEPS=12
TICKETPILOT_MAX_TOTAL_TOKENS=200000

# --- Storage / runtime ----------------------------------------------------
TICKETPILOT_DB=var/ticketpilot.db
# The store's clock is pinned so policy windows (30-day returns...) are reproducible.
TICKETPILOT_STORE_DATE=2026-10-06
# Where the no-API carrier portal lives. "inproc" renders it in-process (tests/evals).
TICKETPILOT_PORTAL_BASE_URL=inproc
# Browser engine for the no-API fallback: "playwright" | "http"
TICKETPILOT_BROWSER_ENGINE=http

# --- Public demo hardening -----------------------------------------------
TICKETPILOT_PUBLIC_DEMO=false
TICKETPILOT_DAILY_SPEND_CAP_USD=5.00
TICKETPILOT_RATE_LIMIT_PER_MIN=10
